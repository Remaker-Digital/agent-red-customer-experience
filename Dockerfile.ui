# Optional UI overlay after building the local frontend bundles.
ARG BASE_IMAGE=agent-red-evaluation-api:2.0.24
FROM ${BASE_IMAGE}
USER root
COPY --chown=agentred:agentred admin/shopify/dist/ ./admin/shopify/dist/
COPY --chown=agentred:agentred admin/standalone/dist/ ./admin/standalone/dist/
COPY --chown=agentred:agentred admin/provider/dist/ ./admin/provider/dist/
COPY --chown=agentred:agentred widget/dist/ ./widget/dist/
USER agentred
