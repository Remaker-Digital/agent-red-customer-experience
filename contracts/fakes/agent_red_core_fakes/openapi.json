{
  "openapi": "3.1.0",
  "info": {
    "title": "Agent Red operator read API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://core.example.invalid"
    }
  ],
  "paths": {
    "/api/superadmin/tenants": {
      "get": {
        "tags": [
          "superadmin"
        ],
        "summary": "List all tenants (cross-partition)",
        "description": "Provider-only: lists all tenants with filtering by status, tier, and billing channel. Performs a cross-partition Cosmos DB query.",
        "operationId": "list_tenants",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by tenant status",
              "title": "Status"
            },
            "description": "Filter by tenant status"
          },
          {
            "name": "tier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by subscription tier",
              "title": "Tier"
            },
            "description": "Filter by subscription tier"
          },
          {
            "name": "billing_channel",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by billing channel",
              "title": "Billing Channel"
            },
            "description": "Filter by billing channel"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Pagination offset",
              "default": 0,
              "title": "Skip"
            },
            "description": "Pagination offset"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Page size",
              "default": 50,
              "title": "Limit"
            },
            "description": "Page size"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantDirectoryResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or invalid credentials"
          },
          "403": {
            "description": "Tenant inactive or insufficient permissions"
          },
          "429": {
            "description": "Rate limit exceeded"
          },
          "503": {
            "description": "Service not initialized"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "PlatformAdminKey": []
          }
        ],
        "x-required-role": "platform_admin"
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TenantDirectoryResponse": {
        "properties": {
          "tenants": {
            "items": {
              "$ref": "#/components/schemas/TenantSummaryItem"
            },
            "type": "array",
            "title": "Tenants"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "skip": {
            "type": "integer",
            "title": "Skip"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "tenants",
          "total",
          "skip",
          "limit"
        ],
        "title": "TenantDirectoryResponse",
        "description": "Paginated tenant directory response."
      },
      "TenantSummaryItem": {
        "properties": {
          "tenantId": {
            "type": "string",
            "title": "Tenantid"
          },
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier"
          },
          "billingChannel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Billingchannel"
          },
          "customerEmail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Customeremail"
          },
          "shopifyShopDomain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shopifyshopdomain"
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Createdat"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          },
          "deactivatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deactivatedat"
          },
          "consentStatus": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Consentstatus"
          },
          "expiresAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiresat"
          }
        },
        "type": "object",
        "required": [
          "tenantId",
          "status"
        ],
        "title": "TenantSummaryItem",
        "description": "Single tenant in the directory listing.\n\nSPEC-1843 v6 boundary: ``customer_email`` and ``shopify_shop_domain``\nare TENANCY MANAGEMENT data (SPEC-1637: required for tenancy setup,\nbilling, and technical communication).  These are superadmin contact\nand storefront identifiers, NOT end-customer PII.\n\nWI-1641: fields restored after S137 audit found WI-1611 over-applied\nthe ZK mandate."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "PlatformAdminKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
